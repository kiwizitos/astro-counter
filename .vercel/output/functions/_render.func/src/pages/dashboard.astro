---
/**
 * Dashboard page — user's overview with their groups.
 * Protected by middleware.
 */
import AppLayout from '@/components/layout/AppLayout.astro';
import GroupList from '@/components/islands/GroupList';
import QueryProvider from '@/components/islands/QueryProvider';

const { user } = Astro.locals;
const userId = user!.id;
---

<AppLayout title="Dashboard">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold">Dashboard</h1>
      <p class="text-muted-foreground text-sm mt-1">
        Bem-vindo de volta! Veja seus grupos e contadores.
      </p>
    </div>

    <!--
      GroupList já inclui o QueryProvider internamente.
      Em Astro, cada island é hidratado de forma independente.
    -->
    <GroupList userId={userId} client:load />
  </div>
</AppLayout>
